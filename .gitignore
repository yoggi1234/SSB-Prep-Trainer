node_modules/
release/
dist/
*.log
.DS_Store
Thumbs.db

# Build scratch: the icon source and the temporary TAT download folder.
build/
.tmpimg/
.tat-build-state.json

# The classic TAT set is user-supplied practice material (see NOTICE.txt).
# It is not covered by this project's licence and must not be redistributed,
# so it is deliberately left out of this repository.
data/tat-classic/
# The PPDT practice pictures are user-supplied too: kept out of the repository.
data/ppdt/

# Throwaway screenshot folders from repeated local smoke runs.
screenshots2/
screenshots3/

# Generated by `graphify .` — a local index of the code, not part of the app.
graphify-out/

# Android build tree generated by `npx cap add android` and the phone bundle
# generated by `tools/build-mobile.js`. Both are rebuilt from the renderer and
# data on demand; only `capacitor.config.json` and the build tool are tracked.
android/
mobile/www/

# Smoke-run report: holds local file paths, so it stays on this machine.
screenshots/report.json
